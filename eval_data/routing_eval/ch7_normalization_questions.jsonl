# Chapter 7 (normalization) questions, labelled against udoc_8897c006f6f9 (ch7.pdf, sha256 2cc2f9de...).
# Written against the slide text; one chunk per slide. Reference answers are short paraphrases of the slide.
{"question_id": "c7_01", "category": "definition", "question": "What is a lossless decomposition?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0005"], "reference_answer": "There is no loss of information when R is replaced by the two schemas R1 and R2.", "notes": "chapter 7"}
{"question_id": "c7_02", "category": "exact_terminology", "question": "When is a decomposition of R into R1 and R2 lossless in terms of functional dependencies?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0015"], "reference_answer": "If R1 ∩ R2 → R1 or R1 ∩ R2 → R2 is in F+.", "notes": "chapter 7"}
{"question_id": "c7_03", "category": "multi_passage", "question": "Why is decomposing employee into employee1(ID, name) and employee2(name, street, city, salary) lossy?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0003", "udoc_8897c006f6f9:0004"], "reference_answer": "Two employees can have the same name, so the original relation cannot be reconstructed.", "notes": "chapter 7"}
{"question_id": "c7_04", "category": "paraphrase", "question": "A functional dependency is a generalization of which database concept?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0009"], "reference_answer": "The notion of a key.", "notes": "chapter 7"}
{"question_id": "c7_05", "category": "definition", "question": "What does it mean for the functional dependency α → β to hold on R?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0010"], "reference_answer": "Whenever two tuples agree on α they also agree on β.", "notes": "chapter 7"}
{"question_id": "c7_06", "category": "definition", "question": "What is a trivial functional dependency?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0014"], "reference_answer": "One that is satisfied by all instances of a relation, where β is a subset of α.", "notes": "chapter 7"}
{"question_id": "c7_07", "category": "definition", "question": "What is the closure of a set of functional dependencies F?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0011"], "reference_answer": "The set of all functional dependencies logically implied by F, denoted F+.", "notes": "chapter 7"}
{"question_id": "c7_08", "category": "exact_terminology", "question": "Which rules are Armstrong's axioms?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0034"], "reference_answer": "The reflexive, augmentation and transitivity rules.", "notes": "chapter 7"}
{"question_id": "c7_09", "category": "paraphrase", "question": "How can you test whether an attribute set α is a superkey?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0040"], "reference_answer": "Compute the attribute closure α+ and check that it contains all attributes of R.", "notes": "chapter 7"}
{"question_id": "c7_10", "category": "definition", "question": "What is a canonical cover of a set of functional dependencies?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0041", "udoc_8897c006f6f9:0047"], "reference_answer": "A simplified set of functional dependencies with the same closure as the original set.", "notes": "chapter 7"}
{"question_id": "c7_11", "category": "definition", "question": "When is an attribute extraneous in a functional dependency?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0044"], "reference_answer": "If it can be removed without changing the closure F+.", "notes": "chapter 7"}
{"question_id": "c7_12", "category": "exact_terminology", "question": "When is a relation schema R in Boyce-Codd normal form?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0019"], "reference_answer": "For every nontrivial α → β in F+, α is a superkey for R.", "notes": "chapter 7"}
{"question_id": "c7_13", "category": "exact_terminology", "question": "Why is in_dep(ID, name, salary, dept_name, building, budget) not in BCNF?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0020"], "reference_answer": "dept_name → building, budget holds but dept_name is not a superkey.", "notes": "chapter 7"}
{"question_id": "c7_14", "category": "exact_terminology", "question": "How does the BCNF decomposition algorithm split a schema R on a violating dependency α → β?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0021"], "reference_answer": "Into (α ∪ β) and (R − (β − α)).", "notes": "chapter 7"}
{"question_id": "c7_15", "category": "definition", "question": "When is a relation schema in third normal form?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0024"], "reference_answer": "For each nontrivial α → β, α is a superkey or each attribute in β − α is in a candidate key.", "notes": "chapter 7"}
{"question_id": "c7_16", "category": "paraphrase", "question": "What advantage does 3NF have over BCNF?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0027"], "reference_answer": "A 3NF design can always be obtained without losing losslessness or dependency preservation.", "notes": "chapter 7"}
{"question_id": "c7_17", "category": "paraphrase", "question": "What are the disadvantages of 3NF compared with BCNF?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0027"], "reference_answer": "Null values may be needed and information may be repeated.", "notes": "chapter 7"}
{"question_id": "c7_18", "category": "exact_terminology", "question": "Which dependency in dept_advisor prevents a dependency-preserving BCNF decomposition?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0023"], "reference_answer": "s_ID, dept_name → i_ID.", "notes": "chapter 7"}
{"question_id": "c7_19", "category": "definition", "question": "What does the multivalued dependency Y →→ Z mean?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0071"], "reference_answer": "Given a value of Y, the set of Z values is independent of the set of W values.", "notes": "chapter 7"}
{"question_id": "c7_20", "category": "exact_terminology", "question": "When is a relation schema in fourth normal form?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0075"], "reference_answer": "For every nontrivial α →→ β in D+, α is a superkey for R.", "notes": "chapter 7"}
{"question_id": "c7_21", "category": "definition", "question": "What is first normal form?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0091"], "reference_answer": "All attribute domains are atomic, meaning indivisible.", "notes": "chapter 7"}
{"question_id": "c7_22", "category": "paraphrase", "question": "Why might a designer denormalize a schema?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0082"], "reference_answer": "For performance, because it gives faster lookups by avoiding joins.", "notes": "chapter 7"}
{"question_id": "c7_23", "category": "definition", "question": "What is a temporal functional dependency?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0084"], "reference_answer": "X → Y holds on all snapshots for all legal instances of R.", "notes": "chapter 7"}
{"question_id": "c7_24", "category": "paraphrase", "question": "What is wrong with creating tables earnings_2004, earnings_2005 and so on?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0083"], "reference_answer": "Querying across years is difficult and a new table is needed each year.", "notes": "chapter 7"}
{"question_id": "c7_25", "category": "multi_passage", "question": "What property makes the 3NF decomposition algorithm lossless?", "relevant_chunk_ids": ["udoc_8897c006f6f9:0087"], "reference_answer": "A candidate key of R is contained in one of the relations of the decomposition.", "notes": "chapter 7"}
